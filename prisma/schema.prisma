generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AllianceRole {
  OWNER
  ADMIN
  LEADER
  VIEWER
}

enum Metric_Type {
  NUMERIC
  BOOLEAN
}

// Reporting semantics for a metric (#190): how per-member values should be
// rolled up into an alliance-level summary. SUM/AVERAGE are only valid for
// NUMERIC metrics; TRUE_RATE is only valid for BOOLEAN metrics; NONE is valid
// for either. Enforced both in the domain layer and by a DB CHECK constraint
// (see migration) tying this to Metric.type.
enum MetricSummaryKind {
  SUM
  AVERAGE
  TRUE_RATE
  NONE
}

// #264 PR2: tells the deterministic findings engine whether a period-over-
// period change is worth surfacing as "needs attention" — HIGHER_IS_BETTER
// flags a decrease as adverse, LOWER_IS_BETTER flags an increase, and
// NEUTRAL (the default, safe for every existing metric on migration) never
// produces an adverse-comparison finding regardless of which way the number
// moves. Deliberately never inferred from Metric_Type/MetricSummaryKind/name
// — directionality is a leadership judgment about what the metric measures,
// not something the platform can safely assume (a "reports needed" count
// could be good or bad depending on the alliance's process).
enum MetricTrendDirection {
  HIGHER_IS_BETTER
  LOWER_IS_BETTER
  NEUTRAL
}

enum LeadershipNoteType {
  POSITIVE
  WARNING
  OBSERVATION
  PROMOTION
}

enum LeadershipNoteVisibility {
  LEADERSHIP
  ADMIN
}

enum FeedbackCategory {
  BUG
  IDEA
  CONFUSING
}

model Alliance {
  id                                String                     @id @default(cuid())
  name                              String
  server                            String
  createdAt                         DateTime                   @default(now())
  updatedAt                         DateTime                   @updatedAt
  // Monotonic setup-activity clock; bumped via touchAllianceSetupActivity()'s
  // atomic GREATEST() update on every setup-domain write (#174).
  setupActivityAt                   DateTime                   @default(now())
  allianceMembers                   AllianceMember[]
  metrics                           Metric[]
  memberships                       AllianceMembership[]
  metricPeriods                     MetricPeriod[]
  invitations                       Invitation[]
  betaInvitations                   BetaInvitation[]
  // Live "current access evidence" links from #177 conflict snapshots. SetNull
  // on delete: the immutable *IdSnapshot/*Name columns on those rows retain
  // the audit trail independent of whether this alliance still exists.
  accessRequestTriageConflicts      AccessRequestTriage[]
  accessRequestTriageEventConflicts AccessRequestTriageEvent[]
  memberImports                     MemberImport[]
  memberImportRollbacks             MemberImportRollback[]

  @@unique([name, server])
}

model AllianceMembership {
  id String @id @default(cuid())

  allianceId String
  alliance   Alliance @relation(fields: [allianceId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  role AllianceRole

  createdAt DateTime @default(now())

  @@unique([allianceId, userId])
}

model AllianceMember {
  id          String    @id @default(cuid())
  allianceId  String
  playerName  String
  discordName String?
  thp         Int?
  squadPower  Int?
  role        String?
  joinedAt    DateTime?
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  alliance                    Alliance                     @relation(fields: [allianceId], references: [id])
  metricEntries               MemberMetricEntry[]
  leadershipNotes             LeadershipNote[]
  invitations                 Invitation[]
  memberImportChanges         MemberImportChange[]
  // #277 PR 3: live "still exists" link for a rollback result whose
  // resolution didn't hard-delete the member (SetNull on delete — the
  // MemberImportChange this result points back to, via a Restrict'd FK,
  // retains playerNameSnapshot independent of whether this row survives).
  memberImportRollbackResults MemberImportRollbackResult[]

  @@unique([allianceId, playerName])
  @@index([allianceId, archivedAt])
  @@index([allianceId, userId])
}

enum MemberImportChangeType {
  CREATED
  RESTORED
}

// #277 PR 4 (#282): distinguishes a current-roster import (the default,
// existing behavior) from a purpose-built historical-roster import, whose
// rows can land Active *or* Archived and whose restores preserve — rather
// than overwrite — the existing member's current thp/role. Default CURRENT
// so every pre-existing MemberImport row backfills truthfully: every one of
// them really was a current-roster import.
enum MemberImportMode {
  CURRENT
  HISTORICAL
}

// One row per completed roster/member-data import (#277 PR 1). Deliberately
// named "MemberImport" (not "Import") to leave room for a distinct
// evaluation-result import model later, per #277's own deferred-
// generalization note.
//
// Only written for a successful server-side commit that created or restored
// at least one member. Never written for: client-only preview state,
// validation failures, capacity failures, permission denials, or a
// zero-net-effect commit (e.g. every row skipped as existing/duplicate). This
// keeps "Import History" a leadership-relevant record, not an attempt log.
model MemberImport {
  id         String   @id @default(cuid())
  allianceId String
  alliance   Alliance @relation(fields: [allianceId], references: [id])

  // Actor snapshot, resolved from the database inside the same transaction
  // that writes this row (never trusted from the caller). SetNull so this
  // history survives operator/user deletion; the snapshot columns are the
  // durable record — matches Feedback's submitterEmail/submitterDisplayName
  // and AccessRequestTriageEvent's actorEmail/actorDisplayName precedent.
  actorUserId              String?
  actor                    User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  actorEmailSnapshot       String
  actorDisplayNameSnapshot String?

  // Required: importMembers() validates both as non-empty, length-bounded
  // strings before ever reaching this create — there is no code path that
  // writes a MemberImport without them.
  fileName        String
  // The workbook sheet the import was run from. Matters for multi-sheet
  // workbooks where the wrong sheet could otherwise look identical in history.
  sourceSheetName String

  // Preserve the action's actual skip breakdown (existing skippedExisting/
  // skippedDuplicates/skippedEmptyNames/skippedUnselected) — don't collapse
  // them into one count. Total is derived for display.
  createdCount           Int
  restoredCount          Int
  skippedExistingCount   Int
  skippedDuplicateCount  Int
  skippedEmptyNameCount  Int
  skippedUnselectedCount Int

  // #277 PR 4 (#282): CURRENT for every import before this shipped and for
  // every current-roster import after it — HISTORICAL only for a completed
  // historical-roster import.
  mode MemberImportMode @default(CURRENT)
  // Subset of createdCount: how many of the created members were created
  // directly archived (changeType stays CREATED — see
  // MemberImportChange_created_before_state_check — only archivedAtAfter
  // differs). createdCount - createdArchivedCount derives active creations.
  // Always 0 for a CURRENT-mode import, which never creates an archived
  // member.
  createdArchivedCount Int @default(0)
  // Historical-mode only: an existing *active* member whose row requested
  // Archived. Never auto-applied (see #282's field policy) — reported so
  // the leader knows to use the separate bulk-archive workflow instead.
  // No existing counter fits: skippedExistingCount's own copy specifically
  // means "already matched the requested state", which for an active
  // member requesting Archived is false, not true.
  skippedLifecycleConflictCount Int @default(0)

  createdAt DateTime @default(now())

  changes  MemberImportChange[]
  // #277 PR 3: at most one committed rollback, ever — enforced by
  // MemberImportRollback.memberImportId being @unique, not just by this
  // being an optional-to-one relation.
  rollback MemberImportRollback?

  // Supports the list page's deterministic pagination order (matches the
  // query's ORDER BY createdAt DESC, id DESC exactly, including sort direction).
  @@index([allianceId, createdAt(sort: Desc), id(sort: Desc)])
}

// One row per AllianceMember touched by a MemberImport. Field-level
// before/after snapshot is what PR 3's rollback will diff against the
// member's *current* value to detect conflicting later edits.
model MemberImportChange {
  id             String       @id @default(cuid())
  memberImportId String
  // Restrict, not Cascade: the import is a historical anchor. An accidental
  // header deletion must never silently erase its evidence; explicit tenant
  // cleanup can delete rows in FK order if that's ever required.
  memberImport   MemberImport @relation(fields: [memberImportId], references: [id], onDelete: Restrict)

  // SetNull + snapshot: if a future rollback ever hard-deletes this member,
  // the import's own history must still be readable (ADR-004) even though
  // the member row is gone.
  allianceMemberId   String?
  allianceMember     AllianceMember? @relation(fields: [allianceMemberId], references: [id], onDelete: SetNull)
  playerNameSnapshot String
  // Row position in the source sheet (1-based), already computed client-side
  // as ParsedMember.sourceRow. Drives the detail page's display order.
  sourceRow          Int

  changeType MemberImportChangeType

  // Null "before" for CREATED (nothing existed). Non-null "before" for
  // RESTORED (the member's pre-import state).
  archivedAtBefore DateTime?
  archivedAtAfter  DateTime?
  thpBefore        Int?
  thpAfter         Int?
  roleBefore       String?
  roleAfter        String?

  // Full post-import mutable-scalar snapshot, beyond the thp/role/archivedAt
  // "after" columns above (which exist for the human-readable before/after
  // diff). `updatedAt` alone is not sufficient conflict evidence for PR 3 —
  // it may not reflect raw-SQL writes and isn't a version counter — so these
  // columns give PR 3 an independent, field-by-field equality check against
  // the member's current row before it decides "unchanged since import".
  discordNameAfter     String?
  squadPowerAfter      Int?
  joinedAtAfter        DateTime?
  userIdAfter          String?
  // AllianceMember.updatedAt immediately after this change, taken from the
  // authoritative create/update result. Corroborating evidence alongside the
  // scalar snapshot above — useful for detecting a change-then-revert
  // sequence that leaves scalars matching but updatedAt bumped.
  memberUpdatedAtAfter DateTime

  // #277 PR 3: at most one rollback result, ever, per source change —
  // enforced by MemberImportRollbackResult.memberImportChangeId being
  // @unique, not just by this being an optional-to-one relation.
  rollbackResult MemberImportRollbackResult?

  // Explicit identity: a source row can produce at most one change. Also
  // enforced in code (matching returned member rows back to their source
  // entry — see action.ts) since createManyAndReturn's result order is not
  // guaranteed to match input order.
  @@unique([memberImportId, sourceRow])
  @@index([allianceMemberId])
}

// #277 PR 3: what actually happened to a single MemberImportChange when its
// parent import was rolled back. Deliberately not columns bolted onto
// MemberImportChange itself: that row is the original import's evidence, and
// mixing a second historical event (the rollback) into it would weaken the
// append-only "one row records one thing" audit model the rest of this
// domain follows.
enum MemberImportRollbackResultResolution {
  // CREATED row, hard-deleted: matched its recorded post-import snapshot
  // exactly, had zero protected dependencies, no linked user, and no
  // later-import involvement.
  DELETED
  // RESTORED row, reverted: matched its recorded post-import snapshot
  // exactly (including archivedAt) — archivedAt, thp, and role are put back
  // to their pre-import values as one unit.
  REVERTED_TO_PRE_IMPORT_STATE
  // CREATED row, protected conflict, member currently active: owner
  // explicitly chose to keep it active.
  RETAINED_ACTIVE
  // CREATED row, protected conflict, member currently active: owner
  // explicitly chose to archive it, preserving its history.
  ARCHIVED_PRESERVING_HISTORY
  // CREATED row, protected conflict, member was *already* archived when the
  // rollback ran — left archived. No owner choice is offered here: nothing
  // about a rollback should reactivate an already-archived member as a side
  // effect, so this is the only safe outcome, not a decision.
  RETAINED_ARCHIVED
  // RESTORED row, conflict: current state no longer matches the recorded
  // post-import snapshot, so nothing is touched. Never actionable — there's
  // no safe partial revert once any tracked field has drifted.
  SKIPPED_CONFLICT
}

enum MemberImportRollbackOutcome {
  // Every change in the import resolved to DELETED or
  // REVERTED_TO_PRE_IMPORT_STATE — a complete, clean undo.
  ROLLED_BACK
  // At least one change resolved to a RETAINED_*/SKIPPED_CONFLICT
  // resolution — an imported member record, or an unretracted restore,
  // remains. Recorded honestly rather than claiming a complete undo.
  ROLLED_BACK_WITH_RETAINED_MEMBERS
}

// One row per committed rollback of a MemberImport (#277 PR 3). At most one
// per import, ever (memberImportId is @unique) — a rollback is a single
// terminal operation, not a retryable/repeatable action. Only written for an
// actual committed transaction; a preview, a permission/validation failure,
// or a stale-preview abort never reaches this table (mirrors MemberImport's
// own "only successful commits enter history" rule).
model MemberImportRollback {
  id String @id @default(cuid())

  memberImportId String       @unique
  memberImport   MemberImport @relation(fields: [memberImportId], references: [id])

  allianceId String
  alliance   Alliance @relation(fields: [allianceId], references: [id])

  // Actor snapshot, resolved from the database inside the same transaction
  // that writes this row — matches MemberImport's own actor-snapshot
  // precedent and rationale.
  actorUserId              String?
  actor                    User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  actorEmailSnapshot       String
  actorDisplayNameSnapshot String?

  outcome MemberImportRollbackOutcome

  // Materialized aggregate counts, one per MemberImportRollbackResultResolution
  // value — stored rather than derived, matching MemberImport's own
  // createdCount/restoredCount/skipped*Count precedent. Tested to equal the
  // grouped count of this rollback's own `results`.
  deletedCount                   Int
  revertedCount                  Int
  retainedActiveCount            Int
  archivedPreservingHistoryCount Int
  retainedArchivedCount          Int
  skippedConflictCount           Int

  createdAt DateTime @default(now())

  results MemberImportRollbackResult[]
}

// One row per MemberImportChange covered by a rollback, recording exactly
// what happened to that member and — for conflicts — exactly why automatic
// rollback wasn't safe. Separate from MemberImportChange itself (see that
// model's rollbackResult doc comment) so the original import's evidence stays
// immutable and this rollback's own evidence is equally durable.
model MemberImportRollbackResult {
  id String @id @default(cuid())

  memberImportRollbackId String
  // Restrict, not Cascade: same historical-anchor rationale as
  // MemberImportChange.memberImportId.
  memberImportRollback   MemberImportRollback @relation(fields: [memberImportRollbackId], references: [id], onDelete: Restrict)

  memberImportChangeId String             @unique
  memberImportChange   MemberImportChange @relation(fields: [memberImportChangeId], references: [id], onDelete: Restrict)

  // SetNull: a DELETED resolution removes this member entirely. The Restrict
  // on memberImportChangeId above keeps playerNameSnapshot reachable
  // regardless, so this staying null on deletion loses no evidence.
  allianceMemberId String?
  allianceMember   AllianceMember? @relation(fields: [allianceMemberId], references: [id], onDelete: SetNull)

  resolution MemberImportRollbackResultResolution

  // Structured conflict evidence. Left at defaults (empty/false/zero) for
  // the two non-conflict resolutions (DELETED, REVERTED_TO_PRE_IMPORT_STATE);
  // populated for every conflict resolution so the UI can explain *why* a
  // given member wasn't touched, not just that it wasn't. `memberMissing` is
  // its own field, not inferred from the others being all-empty — a missing
  // member's evidence *is* all-empty (nothing left to read), and collapsing
  // that into "no evidence recorded" would make this the one conflict cause
  // the durable view could never recover after the fact.
  memberMissing             Boolean  @default(false)
  driftedFields             String[] @default([])
  hadLaterImportInvolvement Boolean  @default(false)
  hadLinkedUser             Boolean  @default(false)
  metricEntryCount          Int      @default(0)
  leadershipNoteCount       Int      @default(0)
  invitationCount           Int      @default(0)

  @@index([memberImportRollbackId])
}

model User {
  id                      String    @id @default(cuid())
  // Reserved for future localization support. Do not expose as an account
  // preference until the app has real i18n behavior (no control without
  // behavior). See the "No speculative preferences" decision on issue #125.
  preferredLanguage       String    @default("en")
  email                   String    @unique
  displayName             String
  // Authentication capabilities are modeled as the presence of provider-specific
  // credentials, not a mutually exclusive provider enum. A user may have both,
  // enabling password + Google on the same canonical identity (email). See ADR-013.
  passwordHash            String?
  googleSubject           String?   @unique
  // Provider metadata, NOT an identity key (ADR-013 #131): the verified email of
  // the connected Google account, captured on connect and refreshed on Google
  // sign-in purely so the UI can show "Connected as <email>". Deliberately not
  // @unique and never copied into `email` — Google authenticates, AllianceHQ
  // owns the profile. Cleared on disconnect.
  googleEmail             String?
  // Set when the user explicitly disconnects Google (ADR-013 identity
  // management, #131). Gives `googleSubject == null` durable meaning: null flag
  // = legacy account still eligible for automatic email-match linking; set flag
  // = the owner intentionally disconnected, so normal Google sign-in must NOT
  // silently re-link. Explicit connect clears it.
  googleAutoLinkBlockedAt DateTime?
  isPlatformAdmin         Boolean   @default(false)
  // Authoritative session-invalidation version. Stamped onto the JWT at sign-in
  // and revalidated against this column on every authenticated request. Bumping
  // it (see revokeSessions) rejects all previously issued tokens. Unlike the
  // isPlatformAdmin hint, this is an invariant, not a snapshot. See issue #132.
  sessionVersion          Int       @default(0)

  memberships                       AllianceMembership[]
  authoredNotes                     LeadershipNote[]
  linkedMembers                     AllianceMember[]
  invitationsSent                   Invitation[]                    @relation("InvitationsSent")
  invitationsAccepted               Invitation[]                    @relation("InvitationsAccepted")
  betaInvitationsAccepted           BetaInvitation[]                @relation("BetaInvitationsAccepted")
  betaInvitationsIssued             BetaInvitation[]                @relation("BetaInvitationsIssued")
  betaInvitationsRevoked            BetaInvitation[]                @relation("BetaInvitationsRevoked")
  betaParticipant                   BetaParticipant?
  betaInvitationDeliveryAttempts    BetaInvitationDeliveryAttempt[]
  feedback                          Feedback[]
  feedbackTriageEvents              FeedbackTriageEvent[]
  emailChangeRequests               EmailChangeRequest[]
  passwordResetTokens               PasswordResetToken[]
  // #177: live "current access evidence" links (SetNull on delete — the
  // immutable conflictUserIdSnapshot/*Email/*DisplayName columns retain the
  // audit trail independent of whether this account still exists) and the
  // triage event actor link (also SetNull; actorEmail/actorDisplayName are
  // snapshotted on every event so attribution survives account deletion).
  accessRequestTriageConflicts      AccessRequestTriage[]
  accessRequestTriageEventConflicts AccessRequestTriageEvent[]      @relation("AccessRequestTriageEventConflictUser")
  accessRequestTriageEventsActedOn  AccessRequestTriageEvent[]      @relation("AccessRequestTriageEventActor")
  // #277: live actor link (SetNull on delete — actorEmailSnapshot/
  // actorDisplayNameSnapshot on MemberImport retain attribution independent
  // of whether this account still exists).
  memberImportsActedOn              MemberImport[]
  // #277 PR 3: same actor-snapshot precedent, for rollbacks.
  memberImportRollbacksActedOn      MemberImportRollback[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Single-use, hashed password reset tokens.
//
// The raw token lives only in the emailed link; we persist a SHA-256 hash so a
// database leak can't be replayed to reset passwords. `usedAt` enforces
// one-time use and `expiresAt` bounds the window. Deleted with the user
// (Cascade).
//
// INVARIANT (not expressible in Prisma schema): at most one ACTIVE (unused)
// token per user. Enforced by a partial unique index —
// `PasswordResetToken_userId_active_key ON ("userId") WHERE "usedAt" IS NULL` —
// created in migration 20260722010000_password_reset_one_active_per_user.
// Prisma can't model partial/filtered indexes, so it isn't declared here; do
// NOT "fix" a migrate-dev drift prompt by dropping that index.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// A pending, verified email change (ADR-015). Email is the canonical identity
// (ADR-013), so changing it is a security-sensitive workflow, not a profile
// edit: the begin step re-authenticates (auth + current password) and this row
// captures a single-use token proving ownership of the destination inbox.
//
// The raw token is never stored: only its SHA-256 hash lives here, so a database
// leak cannot be replayed into an account takeover. `consumedAt` means the change
// was actually confirmed; a superseded request is deleted rather than marked, so
// a missing row unambiguously means "no longer valid".
model EmailChangeRequest {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  newEmail   String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model Metric {
  id String @id @default(cuid())

  allianceId  String
  alliance    Alliance @relation(fields: [allianceId], references: [id])
  name        String
  description String?

  type   Metric_Type
  active Boolean     @default(true)

  // #190: reporting semantics. summaryKind defaults to NONE ("no rollup
  // configured yet") rather than guessing, so every existing metric backfills
  // to an honest, valid state. unitLabel is a short display suffix (e.g.
  // "pts", "donations") shown alongside formatted values.
  summaryKind MetricSummaryKind @default(NONE)
  unitLabel   String?

  // #264 PR2: see MetricTrendDirection. Defaults to NEUTRAL so every
  // existing metric backfills to "no adverse-comparison finding possible"
  // rather than silently reinterpreting its historical comparisons.
  trendDirection MetricTrendDirection @default(NEUTRAL)

  periodMetrics MetricPeriodMetric[]

  createdAt DateTime @default(now())

  @@unique([allianceId, name])
}

model MetricPeriod {
  id String @id @default(cuid())

  allianceId String
  alliance   Alliance @relation(fields: [allianceId], references: [id])

  name String

  active Boolean @default(true)

  startsAt DateTime?
  endsAt   DateTime?

  periodMetrics MetricPeriodMetric[]

  createdAt DateTime @default(now())
}

model MetricPeriodMetric {
  periodId String
  period   MetricPeriod @relation(fields: [periodId], references: [id])

  metricId String
  metric   Metric @relation(fields: [metricId], references: [id])

  weight   Int
  required Boolean
  active   Boolean @default(true)

  memberMetricEntries MemberMetricEntry[]

  @@id([periodId, metricId])
}

model MemberMetricEntry {
  id String @id @default(cuid())

  allianceMemberId String
  allianceMember   AllianceMember @relation(fields: [allianceMemberId], references: [id])

  periodId     String
  metricId     String
  periodMetric MetricPeriodMetric @relation(fields: [periodId, metricId], references: [periodId, metricId])

  value Int

  recordedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([allianceMemberId, periodId])
  @@index([metricId])
  // #190: supports the per-metric report's `DISTINCT ON ("allianceMemberId")`
  // latest-entry-per-member query: an index scan filters by periodId/metricId
  // and the trailing sort-ordered columns match that query's ORDER BY
  // exactly, so Postgres needs no separate sort step for the DISTINCT ON.
  // Not an index-only scan — `value` isn't part of the index, so a heap
  // fetch is still required for each selected row.
  @@index([periodId, metricId, allianceMemberId, recordedAt(sort: Desc), createdAt(sort: Desc), id(sort: Desc)])
}

model LeadershipNote {
  id String @id @default(cuid())

  allianceMemberId String
  allianceMember   AllianceMember @relation(fields: [allianceMemberId], references: [id])

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  noteType   LeadershipNoteType
  visibility LeadershipNoteVisibility
  title      String?
  content    String

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Invitation {
  id String @id @default(cuid())

  allianceId String
  alliance   Alliance @relation(fields: [allianceId], references: [id])

  invitedById String
  invitedBy   User   @relation("InvitationsSent", fields: [invitedById], references: [id])

  allianceMemberId   String?
  allianceMember     AllianceMember? @relation(fields: [allianceMemberId], references: [id])
  playerNameSnapshot String

  email          String
  membershipRole AllianceRole
  token          String       @unique
  code           String?      @unique

  expiresAt        DateTime
  acceptedAt       DateTime?
  acceptedByUserId String?
  acceptedByUser   User?     @relation("InvitationsAccepted", fields: [acceptedByUserId], references: [id])
  cancelledAt      DateTime?

  createdAt DateTime @default(now())

  @@index([allianceId, email])
}

model BetaParticipant {
  id                                String                     @id @default(cuid())
  createdAt                         DateTime                   @default(now())
  // DB-level @unique contract lands in PR 1c (#174); required here for Prisma's
  // one-to-one relation shape.
  userId                            String?                    @unique
  user                              User?                      @relation(fields: [userId], references: [id], onDelete: SetNull)
  identityAmbiguous                 Boolean                    @default(false)
  invitations                       BetaInvitation[]
  // #177: live link from a CONVERSION_BLOCKED event's participant-identity
  // conflict (EXISTING_PARTICIPANT_REISSUE / IDENTITY_AMBIGUOUS). SetNull on
  // delete — conflictParticipantIdSnapshots retains the immutable audit trail.
  accessRequestTriageEventConflicts AccessRequestTriageEvent[]
}

model BetaInvitation {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  code      String   @unique
  notes     String?
  campaign  String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  issuedAt  DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  participantId String
  participant   BetaParticipant @relation(fields: [participantId], references: [id])

  issuedByUserId String?
  issuedBy       User?   @relation("BetaInvitationsIssued", fields: [issuedByUserId], references: [id], onDelete: SetNull)

  revokedByUserId String?
  revokedBy       User?   @relation("BetaInvitationsRevoked", fields: [revokedByUserId], references: [id], onDelete: SetNull)

  // DB-level @unique contract lands in PR 1c (#174); required here for Prisma's
  // one-to-one reissue successor relation.
  reissuedFromInvitationId String?         @unique
  reissuedFrom             BetaInvitation? @relation("BetaInvitationReissue", fields: [reissuedFromInvitationId], references: [id])
  reissuedTo               BetaInvitation? @relation("BetaInvitationReissue")

  resendClaimedAt DateTime?
  resendClaimId   String?

  acceptedAt       DateTime?
  acceptedByUserId String?
  acceptedByUser   User?     @relation("BetaInvitationsAccepted", fields: [acceptedByUserId], references: [id])

  revokedAt DateTime?

  allianceId String?
  alliance   Alliance? @relation(fields: [allianceId], references: [id])

  deliveryAttempts BetaInvitationDeliveryAttempt[]

  // #177: reverse relations for the AccessRequest triage conversion contract.
  // All Restrict — a BetaInvitation is durable history (ADR-004) and cleanup
  // never hard-deletes it, so these can never block a legitimate cleanup run.
  accessRequestTriageLink           AccessRequestTriage?       @relation("AccessRequestTriageInvitation")
  accessRequestTriageEventConflicts AccessRequestTriageEvent[] @relation("AccessRequestTriageEventConflictInvitation")
  accessRequestTriageEventLinks     AccessRequestTriageEvent[] @relation("AccessRequestTriageEventInvitation")

  @@index([email])
  @@index([participantId])
}

// Immutable, append-only record of every real invocation of the beta
// invitation email transport (#175). Never fabricated: a row exists only
// when `send()` was actually called and its `EmailResult` observed at the
// service boundary in betaInvitation.ts. `onDelete: Restrict` on the
// invitation FK is deliberate — this is durable audit history and must
// never be silently cascaded away. Safe as-is: betaCleanup.ts/betaCleanupDb.ts
// never hard-delete a BetaInvitation row (only nullify/revoke it), so this
// constraint cannot break that tool; only test fixtures that directly
// `betaInvitation.delete(...)` need to clear their own attempts first.
model BetaInvitationDeliveryAttempt {
  id           String         @id @default(cuid())
  invitationId String
  invitation   BetaInvitation @relation(fields: [invitationId], references: [id], onDelete: Restrict)

  trigger BetaInvitationDeliveryTrigger
  status  BetaInvitationDeliveryStatus

  // Only ever set when status = SENT; discarded otherwise (see
  // deliverBetaInvitationEmail's canonicalization mapping).
  providerMessageId String?
  // Sanitized, bounded, and only ever set when status = FAILED. Falls back to
  // a generic reason when the transport didn't provide one, so a bare
  // `{ status: "failed" }` result still records (see canonicalization mapping).
  failureReason     String?

  // Nullable + SetNull so history survives operator deletion; email/display
  // name are snapshotted from the database at write time (never trusted from
  // the action layer) so attribution survives even after that.
  attemptedByUserId      String?
  attemptedBy            User?   @relation(fields: [attemptedByUserId], references: [id], onDelete: SetNull)
  attemptedByEmail       String
  attemptedByDisplayName String?

  // Fresh UUID per helper invocation. Not a dedup key — the resend/reissue
  // claim already prevents duplicate transport calls. Purely evidentiary,
  // threaded into EmailMetadata so transport console logs correlate to this
  // row when reasoning about retries.
  requestId String

  createdAt DateTime @default(now())

  @@index([invitationId, createdAt, id])
  @@index([attemptedByUserId])
}

enum BetaInvitationDeliveryTrigger {
  ISSUE
  RESEND
  REISSUE
}

enum BetaInvitationDeliveryStatus {
  SENT
  FAILED
  SKIPPED
}

// A prospective user expressing interest in the beta. Intentionally separate
// from the invitation model (ADR-014 keeps notification vs. domain concerns
// distinct): an access request is not an invitation, it merely captures
// interest. An administrator later reviews requests and issues invitations
// through the existing invitation flow. Kept deliberately minimal for beta;
// status/approval workflow can be layered on later without a redesign.
model AccessRequest {
  id           String   @id @default(cuid())
  name         String
  email        String
  allianceName String?
  message      String?
  createdAt    DateTime @default(now())

  // #177: operator triage state and its append-only decision history.
  // Restrict on both — this row is the anchor for durable decision history
  // (ADR-004) and must never be silently cascaded away; the cleanup tool
  // deletes AccessRequestTriageEvent then AccessRequestTriage as explicit,
  // FK-ordered plan ops before deleting an AccessRequest.
  triage AccessRequestTriage?
  events AccessRequestTriageEvent[]

  @@index([createdAt])
}

enum AccessRequestTriageStatus {
  PENDING
  INVITED
  DECLINED
  RESOLVED_EXISTING_ACCESS
}

enum AccessRequestTriageEventType {
  NOTE_ADDED
  CONVERSION_BLOCKED
  INVITED
  DECLINED
  REOPENED
  RESOLVED_EXISTING_ACCESS
}

// Authoritative classification of why an email cannot be issued a beta
// invitation right now — shared between issueBetaInvitationWithTx's conflict
// resolver (betaInvitation.ts / invitationConflict.ts) and the triage event
// log below (#177).
enum InvitationConflictType {
  NONE
  ACTIVE_PENDING_INVITATION
  EXISTING_ALLIANCE_ACCESS
  IDENTITY_AMBIGUOUS
  ALREADY_ACCEPTED
  EXISTING_PARTICIPANT_REISSUE
}

// Current triage state projection for one AccessRequest (#177), mirroring the
// FeedbackTriage split: AccessRequest itself is the immutable submission,
// this is the mutable "current state" row, and AccessRequestTriageEvent below
// is the append-only decision trail. One row per AccessRequest, created
// lazily (defaults to PENDING) the first time it is triaged.
model AccessRequestTriage {
  accessRequestId String                    @id
  accessRequest   AccessRequest             @relation(fields: [accessRequestId], references: [id], onDelete: Restrict)
  status          AccessRequestTriageStatus @default(PENDING)

  // Set only once, at INVITED. @unique enforces "at most one live INVITED
  // link" — the sole DB-level guarantee that a request is never converted
  // twice. Restrict: this invitation is durable history (ADR-004).
  linkedInvitationId String?         @unique
  linkedInvitation   BetaInvitation? @relation("AccessRequestTriageInvitation", fields: [linkedInvitationId], references: [id], onDelete: Restrict)
  // Denormalized copy of the wave the request was converted into, for list
  // display/filtering without a join. Authoritative value lives on
  // BetaInvitation.campaign; this is a read-model convenience only.
  betaWave           String?

  // "Current access evidence" for RESOLVED_EXISTING_ACCESS — refreshed (and
  // stateRevision bumped) whenever a denied reopen re-derives access.
  // Live links are optional and unconstrained by any CHECK (SetNull on
  // delete); the *Snapshot/*Email/*Name/*Count columns are the immutable,
  // required-when-populated audit record and are what every CHECK targets.
  conflictUserId             String?
  conflictUser               User?     @relation(fields: [conflictUserId], references: [id], onDelete: SetNull)
  conflictUserIdSnapshot     String?
  conflictUserEmail          String?
  conflictUserDisplayName    String?
  conflictAllianceId         String?
  conflictAlliance           Alliance? @relation(fields: [conflictAllianceId], references: [id], onDelete: SetNull)
  conflictAllianceIdSnapshot String?
  conflictAllianceName       String?
  conflictMembershipCount    Int?

  // Operator-supplied free text for the CURRENT state (decline/resolution/
  // reopen reason, or latest note) — bounded 1-500 chars when set. The full
  // reasoning trail lives in AccessRequestTriageEvent; this is a display
  // convenience so the queue doesn't need to join the latest event.
  currentReason String?

  stateRevision                   Int       @default(0)
  lastEventAt                     DateTime?
  // Actor of the most recent event of ANY kind (including notes), so list
  // rows can show "last touched by" without joining the event log.
  lastEventActorEmail             String?
  lastEventActorDisplayName       String?
  // Actor of the most recent STATE-CHANGING event (mirrors FeedbackTriage).
  lastStateChangeAt               DateTime?
  lastStateChangeActorEmail       String?
  lastStateChangeActorDisplayName String?

  @@index([status])
  @@index([betaWave])
}

// Append-only decision history for one AccessRequest (#177). Every row is a
// single meaningful, request-scoped event — never page views, validation
// errors, or generic system noise (ADR-004: leadership-relevant history is
// preserved, never overwritten). Payload columns are event-type-specific;
// see the migration's CHECK constraints for the exact required-vs-forbidden
// matrix per eventType/blockedConflictType.
model AccessRequestTriageEvent {
  id              String        @id @default(cuid())
  accessRequestId String
  accessRequest   AccessRequest @relation(fields: [accessRequestId], references: [id], onDelete: Restrict)

  eventType      AccessRequestTriageEventType
  previousStatus AccessRequestTriageStatus?
  nextStatus     AccessRequestTriageStatus?

  noteText         String? // NOTE_ADDED only — required, 1-2000 chars (incl. the canonical denied-reopen note)
  declineReason    String? // DECLINED only — required, 1-500 chars
  resolutionReason String? // RESOLVED_EXISTING_ACCESS only — required, 1-500 chars
  reopenReason     String? // REOPENED only — required, 1-500 chars
  betaWave         String? // INVITED only — required, 1-80 chars

  // CONVERSION_BLOCKED only — both required together, blockedConflictType <> NONE.
  blockedReason       String?
  blockedConflictType InvitationConflictType?

  // Populated for RESOLVED_EXISTING_ACCESS (always) and CONVERSION_BLOCKED
  // where blockedConflictType = EXISTING_ALLIANCE_ACCESS, and optionally for
  // a NOTE_ADDED denied-reopen event (refreshed evidence). Live links are
  // optional/unconstrained (SetNull); the snapshot/email/name/count columns
  // are the immutable evidence every CHECK targets.
  conflictUserId             String?
  conflictUser               User?     @relation("AccessRequestTriageEventConflictUser", fields: [conflictUserId], references: [id], onDelete: SetNull)
  conflictUserIdSnapshot     String?
  conflictUserEmail          String?
  conflictUserDisplayName    String?
  conflictAllianceId         String?
  conflictAlliance           Alliance? @relation(fields: [conflictAllianceId], references: [id], onDelete: SetNull)
  conflictAllianceIdSnapshot String?
  conflictAllianceName       String?
  conflictMembershipCount    Int?

  // CONVERSION_BLOCKED only, blockedConflictType IN (ACTIVE_PENDING_INVITATION, ALREADY_ACCEPTED).
  // Restrict: BetaInvitation is durable history, never deleted by cleanup.
  conflictInvitationId String?
  conflictInvitation   BetaInvitation? @relation("AccessRequestTriageEventConflictInvitation", fields: [conflictInvitationId], references: [id], onDelete: Restrict)

  // CONVERSION_BLOCKED only, blockedConflictType IN (EXISTING_PARTICIPANT_REISSUE, IDENTITY_AMBIGUOUS).
  // conflictParticipantId is a live, unconstrained convenience link (SetNull);
  // conflictParticipantIdSnapshots is the immutable evidence — exactly one
  // entry for EXISTING_PARTICIPANT_REISSUE, two or more for IDENTITY_AMBIGUOUS.
  conflictParticipantId          String?
  conflictParticipant            BetaParticipant? @relation(fields: [conflictParticipantId], references: [id], onDelete: SetNull)
  conflictParticipantIdSnapshots String[]         @default([])

  // INVITED only — required. Not @unique: the projection's linkedInvitationId
  // is the sole "at most one live link" invariant; this is just a record of
  // which invitation THIS event produced.
  linkedInvitationId String?
  linkedInvitation   BetaInvitation? @relation("AccessRequestTriageEventInvitation", fields: [linkedInvitationId], references: [id], onDelete: Restrict)

  // Actor snapshot, resolved from the database inside the same transaction
  // that writes this event (never trusted from the caller). SetNull so
  // history survives operator deletion; email/displayName are the durable
  // record.
  actorUserId      String?
  actor            User?   @relation("AccessRequestTriageEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  actorEmail       String
  actorDisplayName String?

  createdAt DateTime @default(now())

  @@index([accessRequestId, createdAt, id])
  @@index([actorUserId])
  @@index([linkedInvitationId])
}

enum FeedbackTriageStatus {
  NEW
  TRIAGED
  PLANNED
  RESOLVED
  DISMISSED
}

// In-app feedback captured from an authenticated user while friction is fresh.
// The row stores facts (message + client/context metadata) plus immutable
// submitter identity snapshots (#176). Operator triage state lives on
// FeedbackTriage / FeedbackTriageEvent — never on this row.
model Feedback {
  id                   String           @id @default(cuid())
  userId               String?
  user                 User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  submitterEmail       String?
  submitterDisplayName String?
  category             FeedbackCategory
  message              String
  url                  String
  userAgent            String?
  viewport             String?
  appVersion           String?
  allianceId           String?
  createdAt            DateTime         @default(now())

  triage FeedbackTriage?
  events FeedbackTriageEvent[]

  @@index([createdAt])
  @@index([allianceId])
}

model FeedbackTriage {
  feedbackId                      String               @id
  feedback                        Feedback             @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  status                          FeedbackTriageStatus @default(NEW)
  needsResponse                   Boolean              @default(true)
  githubIssueUrl                  String?
  stateRevision                   Int                  @default(0)
  lastEventAt                     DateTime?
  lastStateChangeAt               DateTime?
  lastStateChangeActorEmail       String?
  lastStateChangeActorDisplayName String?

  @@index([status])
  @@index([needsResponse])
}

model FeedbackTriageEvent {
  id                      String                @id @default(cuid())
  feedbackId              String
  feedback                Feedback              @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  actorUserId             String?
  actor                   User?                 @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  actorEmail              String
  actorDisplayName        String?
  createdAt               DateTime              @default(now())
  statusChangedTo         FeedbackTriageStatus?
  noteText                String?
  needsResponseChangedTo  Boolean?
  githubIssueUrlChanged   Boolean               @default(false)
  githubIssueUrlChangedTo String?

  @@index([feedbackId, createdAt, id])
  @@index([actorUserId])
}
